@page "/"
@implements IDisposable
@using System.Globalization
@using WeatherShared.Models
@using WeatherApp.Services
@inject WeatherApiClient WeatherApiClient

<PageTitle>Vær</PageTitle>

<section class="weather-shell">
    <div class="weather-header">
        <div>
            <p class="eyebrow">Data fra Meteorologisk institutt</p>
            <h1>Værvarsel</h1>
        </div>

        <form class="location-search" @onsubmit="SearchLocationsAsync" @onsubmit:preventDefault>
            <label for="location-query">Søk etter sted</label>
            <div class="search-row">
                <input id="location-query"
                       class="form-control"
                       type="search"
                       placeholder="Skriv for eksempel Oslo"
                       aria-describedby="location-help"
                       @bind="locationQuery"
                       @bind:event="oninput" />
                <button class="btn btn-primary" type="button" @onclick="SearchLocationsAsync" disabled="@isSearching">
                    Søk
                </button>
            </div>
            <small id="location-help">Søket finner norske steder og henter værvarsel for valgt treff.</small>
        </form>
    </div>

    @if (isSearching)
    {
        <div class="loading-panel compact" role="status" aria-live="polite">Søker etter steder...</div>
    }
    else if (alternativeResults.Count > 0)
    {
        <div class="search-results" aria-label="Søkeresultater">
            <p>Andre mulige treff</p>
            @foreach (var location in alternativeResults)
            {
                <button class="location-result" type="button" @onclick="() => SelectLocationAsync(location)">
                    <span>@location.Name</span>
                </button>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger status-panel" role="alert">@errorMessage</div>
    }
    else if (isLoading)
    {
        <div class="loading-panel" role="status" aria-live="polite">Henter værdata...</div>
    }
    else if (forecast is not null)
    {
        var current = forecast.Forecasts.FirstOrDefault();

        <div class="current-weather">
            <div>
                <p class="eyebrow">@forecast.LocationName</p>
                <p class="temperature">@FormatTemperature(current?.TemperatureC)</p>
                <p class="summary">@current?.Summary</p>
            </div>
            <dl aria-label="Nåværende værdetaljer">
                <div>
                    <dt>Vind</dt>
                    <dd>@FormatWind(current?.WindSpeedMetersPerSecond)</dd>
                </div>
                <div>
                    <dt>Nedbør neste time</dt>
                    <dd>@FormatPrecipitation(current?.PrecipitationMillimeters)</dd>
                </div>
                <div>
                    <dt>Datakilde</dt>
                    <dd>@forecast.Provider</dd>
                </div>
                <div>
                    <dt>Oppdatert</dt>
                    <dd>@forecast.UpdatedAt.ToLocalTime().ToString("HH:mm")</dd>
                </div>
            </dl>
        </div>

        <div class="view-toggle" role="tablist" aria-label="Velg varselvisning">
            <button type="button"
                    role="tab"
                    aria-selected="@(selectedView == ForecastView.Hourly ? "true" : "false")"
                    class="@GetViewButtonClass(ForecastView.Hourly)"
                    @onclick="() => selectedView = ForecastView.Hourly">
                Time for time
            </button>
            <button type="button"
                    role="tab"
                    aria-selected="@(selectedView == ForecastView.Daily ? "true" : "false")"
                    class="@GetViewButtonClass(ForecastView.Daily)"
                    @onclick="() => selectedView = ForecastView.Daily">
                7 dager
            </button>
        </div>

        @if (selectedView == ForecastView.Hourly)
        {
            <section class="temperature-chart" aria-label="Temperaturgraf for de neste 12 timene">
                <div class="chart-header">
                    <h2>Temperatur time for time</h2>
                    <span>Neste 12 timer</span>
                </div>
                @RenderChart(TemperatureChart)
            </section>
        }
        else
        {
            <div class="daily-list" aria-label="7-dagersvarsel">
                @foreach (var day in DailyForecasts)
                {
                    var isExpanded = expandedDate == day.Date;
                    <article class="daily-row @(isExpanded ? "is-expanded" : null)">
                        <div class="daily-row-header"
                             role="button"
                             tabindex="0"
                             aria-expanded="@(isExpanded ? "true" : "false")"
                             aria-label="@($"Time for time for {day.Date.ToString("dddd d. MMMM")}")"
                             @onclick="() => ToggleDay(day.Date)"
                             @onkeydown="args => ToggleDayOnKey(args, day.Date)">
                            <div class="forecast-time">
                                <time datetime="@day.Date.ToString("O")">@day.Date.ToString("dddd d. MMM")</time>
                            </div>
                            <span class="weather-symbol" aria-hidden="true">@((MarkupString)GetWeatherIcon(day.SymbolCode))</span>
                            <div class="forecast-summary">
                                <strong>@day.Summary</strong>
                                <small>Nedbør: @FormatPrecipitation(day.PrecipitationMillimeters)</small>
                            </div>
                            <dl class="temperature-range">
                                <div>
                                    <dt>Høyeste</dt>
                                    <dd>@FormatTemperature(day.MaxTemperatureC)</dd>
                                </div>
                                <div>
                                    <dt>Laveste</dt>
                                    <dd>@FormatTemperature(day.MinTemperatureC)</dd>
                                </div>
                            </dl>
                            <span class="expand-chevron" aria-hidden="true">▾</span>
                        </div>
                        @if (isExpanded)
                        {
                            <div class="daily-expanded">
                                <div class="chart-header">
                                    <h3>Time for time</h3>
                                    <span>@day.Date.ToString("dddd d. MMMM")</span>
                                </div>
                                @RenderChart(BuildDayChart(day.Date))
                            </div>
                        }
                    </article>
                }
            </div>
        }
    }
</section>

@code {
    private const int ForecastPeriodCount = 84;
    private readonly CancellationTokenSource cancellationTokenSource = new();
    private IReadOnlyList<LocationOption> alternativeResults = [];
    private WeatherForecastResponse? forecast;
    private string locationQuery = "Oslo";
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSearching;
    private ForecastView selectedView = ForecastView.Hourly;
    private DateOnly? expandedDate;

    protected override void OnInitialized()
    {
        isLoading = true;
        _ = LoadInitialForecastAsync();
    }

    private async Task LoadInitialForecastAsync()
    {
        try
        {
            // Appen bruker lokal tjeneste for stedsøk, slik at UI-et ikke bindes til valgt søkeleverandør.
            await SearchLocationsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Kunne ikke hente værdata. Sjekk at API-et kjører lokalt. Detaljer: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SearchLocationsAsync()
    {
        if (locationQuery.Trim().Length < 2)
        {
            alternativeResults = [];
            return;
        }

        isSearching = true;
        errorMessage = null;

        try
        {
            var results = await WeatherApiClient.SearchLocationsAsync(locationQuery, cancellationTokenSource.Token);

            if (results.FirstOrDefault() is not { } bestMatch)
            {
                alternativeResults = [];
                forecast = null;
                errorMessage = $"Fant ingen norske steder for \"{locationQuery}\".";
                return;
            }

            alternativeResults = results.Skip(1).ToArray();
            await SelectLocationAsync(bestMatch, clearAlternatives: false);
        }
        catch (Exception ex)
        {
            alternativeResults = [];
            errorMessage = $"Kunne ikke søke etter steder. Detaljer: {ex.Message}";
        }
        finally
        {
            isSearching = false;
        }
    }

    private async Task SelectLocationAsync(LocationOption location, bool clearAlternatives = true)
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            // Varselhentingen avbrytes hvis komponenten fjernes før forespørselen er ferdig.
            forecast = await WeatherApiClient.GetWeatherAsync(location, ForecastPeriodCount, cancellationTokenSource.Token);
            locationQuery = location.Name;
            if (clearAlternatives)
            {
                alternativeResults = [];
            }
        }
        catch (Exception ex)
        {
            forecast = null;
            errorMessage = $"Kunne ikke hente værdata for {location.Name}. Detaljer: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string FormatTemperature(double? value) =>
        value is null ? "-" : $"{value:0.#} °C";

    private static string FormatWind(double? value) =>
        value is null ? "-" : $"{value:0.#} m/s";

    private static string FormatPrecipitation(double? value) =>
        value is null ? "-" : $"{value:0.#} mm";

    private IReadOnlyList<DailyForecast> DailyForecasts =>
        forecast?.Forecasts
            .GroupBy(item => item.Time.ToLocalTime().Date)
            .Take(7)
            .Select(group =>
            {
                var periods = group.ToArray();

                // Velg dagens dominerende værtype ÉN gang, slik at ikon og tekst alltid
                // hører sammen. Tidligere ble teksten (Summary) og ikon-koden (SymbolCode)
                // valgt i hver sin gruppering: Summary slår sammen dag/natt-varianter
                // (clearsky_day + clearsky_night → «Klarvær»), mens SymbolCode teller dem
                // hver for seg. Det kunne gjøre at en «Klarvær»-dag fikk lettskyet-ikonet.
                var dominant = periods
                    .GroupBy(item => item.Summary)
                    .OrderByDescending(weatherType => weatherType.Count())
                    .ThenBy(weatherType => weatherType.Key, StringComparer.Ordinal)
                    .First();

                var summary = dominant.Key;
                var symbolCode = dominant
                    .GroupBy(item => item.SymbolCode)
                    .OrderByDescending(symbol => symbol.Count())
                    .ThenBy(symbol => symbol.Key, StringComparer.Ordinal)
                    .First().Key;

                return new DailyForecast(
                    DateOnly.FromDateTime(group.Key),
                    periods.Where(item => item.TemperatureC is not null).Min(item => item.TemperatureC),
                    periods.Where(item => item.TemperatureC is not null).Max(item => item.TemperatureC),
                    periods.Sum(item => item.PrecipitationMillimeters ?? 0),
                    summary,
                    symbolCode);
            })
            .ToArray() ?? [];

    private TemperatureChartData TemperatureChart
    {
        get
        {
            var now = DateTimeOffset.Now;
            var end = now.AddHours(12);

            return BuildTemperatureChart(
                forecast?.Forecasts
                    .Where(period => period.Time >= now && period.Time <= end)
                    .ToArray() ?? [],
                maxPoints: 12);
        }
    }

    // Bygger en time-for-time-graf for én bestemt dag. Dag 1–2 har timesoppløsning,
    // dag 3 og utover har 6-timersteg, så grafen viser de punktene som finnes for dagen.
    private TemperatureChartData BuildDayChart(DateOnly date) =>
        BuildTemperatureChart(
            forecast?.Forecasts
                .Where(period => DateOnly.FromDateTime(period.Time.ToLocalTime().Date) == date)
                .ToArray() ?? [],
            maxPoints: 24);

    private string GetViewButtonClass(ForecastView view) =>
        selectedView == view ? "active" : string.Empty;

    // Trekkspill: én dag av gangen er utfoldet. Klikk på samme dag igjen lukker den.
    private void ToggleDay(DateOnly date) =>
        expandedDate = expandedDate == date ? null : date;

    // Lar raden foldes ut/inn med tastatur (Enter eller mellomrom), slik at den
    // fungerer som en knapp for tastatur- og skjermleserbrukere.
    private void ToggleDayOnKey(KeyboardEventArgs args, DateOnly date)
    {
        if (args.Key is "Enter" or " " or "Spacebar")
        {
            ToggleDay(date);
        }
    }

    // Full 64x64-ikon til 7-dagerslista.
    private static string GetWeatherIcon(string? symbolCode) =>
        $"""<svg width="64" height="64" viewBox="0 0 64 64" fill="none">{GetWeatherIconBody(symbolCode)}</svg>""";

    // Lite, posisjonert ikon til grafen. Sentreres på (centerX, centerY) med gitt størrelse.
    // Koordinatene formateres med punktum (InvariantCulture) slik at norsk locale ikke gir komma.
    private static string GetWeatherIconSvg(string? symbolCode, double centerX, double centerY, double size)
    {
        var half = size / 2d;
        var x = (centerX - half).ToString("0.#", CultureInfo.InvariantCulture);
        var y = (centerY - half).ToString("0.#", CultureInfo.InvariantCulture);
        var dimension = size.ToString("0.#", CultureInfo.InvariantCulture);
        return $"""<svg x="{x}" y="{y}" width="{dimension}" height="{dimension}" viewBox="0 0 64 64" fill="none">{GetWeatherIconBody(symbolCode)}</svg>""";
    }

    private static string GetWeatherIconBody(string? symbolCode)
    {
        var normalizedCode = symbolCode?.Split('_', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? string.Empty;

        if (normalizedCode.Contains("thunder", StringComparison.OrdinalIgnoreCase))
        {
            return ThunderIconBody;
        }

        if (normalizedCode.Contains("rain", StringComparison.OrdinalIgnoreCase) ||
            normalizedCode.Contains("sleet", StringComparison.OrdinalIgnoreCase))
        {
            return RainIconBody;
        }

        if (normalizedCode.Contains("snow", StringComparison.OrdinalIgnoreCase))
        {
            return CloudIconBody;
        }

        if (normalizedCode.Contains("partlycloudy", StringComparison.OrdinalIgnoreCase))
        {
            return SunCloudIconBody;
        }

        if (normalizedCode.Contains("fair", StringComparison.OrdinalIgnoreCase))
        {
            return FairIconBody;
        }

        if (normalizedCode.Contains("cloud", StringComparison.OrdinalIgnoreCase) ||
            normalizedCode.Contains("fog", StringComparison.OrdinalIgnoreCase))
        {
            return CloudIconBody;
        }

        return SunIconBody;
    }

    private const string SunIconBody = """
          <circle cx="32" cy="32" r="12" fill="#FDB813"/>
          <g stroke="#FDB813" stroke-width="4" stroke-linecap="round">
            <path d="M32 6v8"/>
            <path d="M32 50v8"/>
            <path d="M6 32h8"/>
            <path d="M50 32h8"/>
            <path d="M13.6 13.6l5.6 5.6"/>
            <path d="M44.8 44.8l5.6 5.6"/>
            <path d="M50.4 13.6l-5.6 5.6"/>
            <path d="M19.2 44.8l-5.6 5.6"/>
          </g>
        """;

    private const string CloudIconBody = """
          <path d="M22 46h26a10 10 0 0 0 0-20h-1.2A16 16 0 0 0 16 31a8 8 0 0 0 6 15Z"
                fill="#B8C7D9"/>
        """;

    private const string RainIconBody = """
          <path d="M22 34h26a10 10 0 0 0 0-20h-1.2A16 16 0 0 0 16 19a8 8 0 0 0 6 15Z"
                fill="#B8C7D9"/>
          <g stroke="#3BA7FF" stroke-width="4" stroke-linecap="round">
            <path d="M22 44l-4 8"/>
            <path d="M34 44l-4 8"/>
            <path d="M46 44l-4 8"/>
          </g>
        """;

    private const string ThunderIconBody = """
          <path d="M22 34h26a10 10 0 0 0 0-20h-1.2A16 16 0 0 0 16 19a8 8 0 0 0 6 15Z"
                fill="#8FA1B5"/>
          <path d="M34 34l-8 14h8l-4 12 14-18h-9l5-8h-6Z"
                fill="#FFD43B"/>
        """;

    private const string SunCloudIconBody = """
          <circle cx="24" cy="24" r="10" fill="#FDB813"/>
          <g stroke="#FDB813" stroke-width="3" stroke-linecap="round">
            <path d="M24 6v6"/>
            <path d="M24 36v6"/>
            <path d="M6 24h6"/>
            <path d="M36 24h6"/>
            <path d="M11.3 11.3l4.2 4.2"/>
            <path d="M36.7 11.3l-4.2 4.2"/>
            <path d="M11.3 36.7l4.2 -4.2"/>
          </g>
          <path d="M24 48h26a10 10 0 0 0 0-20h-1.2A16 16 0 0 0 18 33a8 8 0 0 0 6 15Z"
                fill="#B8C7D9"/>
        """;

    private const string FairIconBody = """
          <circle cx="30" cy="26" r="12" fill="#FDB813"/>
          <g stroke="#FDB813" stroke-width="3" stroke-linecap="round">
            <path d="M30 4v7"/>
            <path d="M6 26h7"/>
            <path d="M47 26h7"/>
            <path d="M17.3 13.3l4.2 4.2"/>
            <path d="M42.7 13.3l-4.2 4.2"/>
          </g>
          <path d="M28 48h18a7 7 0 0 0 0-14h-0.9A12 12 0 0 0 22 38a6 6 0 0 0 6 10Z"
                fill="#B8C7D9"/>
        """;

    private static TemperatureChartData BuildTemperatureChart(IReadOnlyList<WeatherForecastPeriod> periods, int maxPoints)
    {
        var values = periods
            .Where(period => period.TemperatureC is not null)
            .OrderBy(period => period.Time)
            .Select(period => new
            {
                period.Time,
                Temperature = period.TemperatureC!.Value,
                period.SymbolCode
            })
            .Take(maxPoints)
            .ToArray();

        if (values.Length == 0)
        {
            return new TemperatureChartData(string.Empty, [], [], []);
        }

        const double left = 48;
        const double right = 690;
        // Ekstra luft på toppen gir plass til værsymbolet som tegnes over hvert punkt.
        const double top = 44;
        const double bottom = 214;
        var min = Math.Floor(values.Min(item => item.Temperature));
        var max = Math.Ceiling(values.Max(item => item.Temperature));
        var range = Math.Max(1, max - min);

        var points = values.Select((item, index) =>
        {
            var x = values.Length == 1
                ? (left + right) / 2
                : left + (right - left) * index / (values.Length - 1);
            var y = bottom - (item.Temperature - min) / range * (bottom - top);

            return new TemperatureChartPoint(
                x,
                y,
                $"{item.Time.ToLocalTime():dddd HH:mm}: {item.Temperature:0.#} °C",
                item.SymbolCode);
        }).ToArray();

        var gridLines = Enumerable.Range(0, 4)
            .Select(index =>
            {
                var value = min + range * index / 3;
                var y = bottom - (value - min) / range * (bottom - top);
                return new TemperatureChartGridLine(y, $"{value:0.#} °C");
            })
            .Reverse()
            .ToArray();

        var timeLabels = values
            .Select((item, index) => new { item.Time, index })
            .Select(item =>
            {
                var x = values.Length == 1
                    ? (left + right) / 2
                    : left + (right - left) * item.index / (values.Length - 1);
                return new TemperatureChartTimeLabel(x, FormatChartTimeLabel(values.Select(value => value.Time).ToArray(), item.index));
            })
            .ToArray();

        return new TemperatureChartData(
            BuildSmoothPath(points),
            points,
            gridLines,
            timeLabels);
    }

    private static string FormatChartTimeLabel(IReadOnlyList<DateTimeOffset> times, int index)
    {
        var currentTime = times[index];
        var localStart = currentTime.ToLocalTime();

        if (index >= times.Count - 1)
        {
            return localStart.ToString("HH");
        }

        var nextTime = times[index + 1];
        var hoursUntilNext = (nextTime - currentTime).TotalHours;

        if (hoursUntilNext <= 1.5)
        {
            return localStart.ToString("HH");
        }

        return $"{localStart:HH}-{nextTime.ToLocalTime():HH}";
    }

    private static string BuildSmoothPath(IReadOnlyList<TemperatureChartPoint> points)
    {
        if (points.Count == 0)
        {
            return string.Empty;
        }

        if (points.Count == 1)
        {
            return $"M {Svg(points[0].X)} {Svg(points[0].Y)}";
        }

        var path = $"M {Svg(points[0].X)} {Svg(points[0].Y)}";

        for (var index = 1; index < points.Count; index++)
        {
            var previous = points[index - 1];
            var current = points[index];
            var controlX = (previous.X + current.X) / 2;

            path += $" C {Svg(controlX)} {Svg(previous.Y)}, {Svg(controlX)} {Svg(current.Y)}, {Svg(current.X)} {Svg(current.Y)}";
        }

        return path;
    }

    // SVG-koordinater må alltid bruke punktum som desimaltegn, uavhengig av
    // brukerens kultur. Uten dette gir for eksempel norsk locale komma, som
    // ødelegger plasseringen av linje, punkter og etiketter.
    private static string Svg(double value) =>
        value.ToString("0.#", CultureInfo.InvariantCulture);

    // Felles tegning av temperaturgrafen. Brukes både i «Time for time»-visningen og når
    // en dag foldes ut i 7-dagersvarselet. Et lite værsymbol tegnes over hvert datapunkt.
    private RenderFragment<TemperatureChartData> RenderChart => chart =>
    @<svg viewBox="0 0 720 260" role="img" aria-label="Temperaturgraf time for time">
        <title>Temperaturgraf time for time</title>

        @foreach (var gridLine in chart.GridLines)
        {
            <line class="chart-grid-line" x1="48" x2="690" y1="@Svg(gridLine.Y)" y2="@Svg(gridLine.Y)" />
            @((MarkupString)$"<text class=\"chart-axis-label\" x=\"12\" y=\"{Svg(gridLine.Y + 5)}\">{gridLine.Label}</text>")
        }

        <path class="chart-line" d="@chart.Path" />

        @foreach (var point in chart.PointItems)
        {
            @((MarkupString)GetWeatherIconSvg(point.SymbolCode, point.X, Math.Max(12, point.Y - 20), 20))
            <circle class="chart-point" cx="@Svg(point.X)" cy="@Svg(point.Y)" r="3.4">
                <title>@point.Label</title>
            </circle>
        }

        @foreach (var label in chart.TimeLabels)
        {
            @((MarkupString)$"<text class=\"chart-time-label\" x=\"{Svg(label.X)}\" y=\"246\">{label.Label}</text>")
        }
    </svg>;

    public void Dispose()
    {
        cancellationTokenSource.Cancel();
        cancellationTokenSource.Dispose();
    }

    private enum ForecastView
    {
        Hourly,
        Daily
    }

    private sealed record DailyForecast(
        DateOnly Date,
        double? MinTemperatureC,
        double? MaxTemperatureC,
        double PrecipitationMillimeters,
        string Summary,
        string? SymbolCode);

    private sealed record TemperatureChartData(
        string Path,
        IReadOnlyList<TemperatureChartPoint> PointItems,
        IReadOnlyList<TemperatureChartGridLine> GridLines,
        IReadOnlyList<TemperatureChartTimeLabel> TimeLabels);

    private sealed record TemperatureChartPoint(double X, double Y, string Label, string? SymbolCode);

    private sealed record TemperatureChartGridLine(double Y, string Label);

    private sealed record TemperatureChartTimeLabel(double X, string Label);
}
